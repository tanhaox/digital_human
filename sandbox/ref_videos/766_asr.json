[
 {
  "start": 0.0,
  "end": 1.6,
  "text": "你身边有没有这样一种人啊"
 },
 {
  "start": 1.6,
  "end": 3.12,
  "text": "就是他今天看看心理学"
 },
 {
  "start": 3.12,
  "end": 4.16,
  "text": "明天看看商业"
 },
 {
  "start": 4.16,
  "end": 5.32,
  "text": "后天又去看看历史"
 },
 {
  "start": 5.32,
  "end": 6.24,
  "text": "看看科技"
 },
 {
  "start": 6.24,
  "end": 7.4,
  "text": "好像什么都懂一点"
 },
 {
  "start": 7.4,
  "end": 8.72,
  "text": "但又谈不上精通"
 },
 {
  "start": 8.72,
  "end": 11.12,
  "text": "看起来好像只是兴趣而好广泛而已"
 },
 {
  "start": 11.12,
  "end": 13.0,
  "text": "但每当一个新技术出现的时候呢"
 },
 {
  "start": 13.0,
  "end": 14.44,
  "text": "他们又学的超级快"
 },
 {
  "start": 14.44,
  "end": 15.48,
  "text": "有新机会出现的时候"
 },
 {
  "start": 15.48,
  "end": 17.4,
  "text": "他们又能快速的抓到本质"
 },
 {
  "start": 17.4,
  "end": 18.36,
  "text": "其实很长一段时间"
 },
 {
  "start": 18.36,
  "end": 20.64,
  "text": "我觉得这种人就是天才"
 },
 {
  "start": 20.64,
  "end": 22.28,
  "text": "因为我就是这样"
 },
 {
  "start": 22.28,
  "end": 23.0,
  "text": "但出列旁通"
 },
 {
  "start": 23.0,
  "end": 26.71,
  "text": "他不就是一种天赋吗"
 },
 {
  "start": 26.71,
  "end": 27.19,
  "text": "好吧"
 },
 {
  "start": 27.19,
  "end": 27.91,
  "text": "他还真不是"
 },
 {
  "start": 29.19,
  "end": 30.31,
  "text": "为什么这么说呢"
 },
 {
  "start": 30.31,
  "end": 31.91,
  "text": "因为其实我查了很多资料"
 },
 {
  "start": 31.91,
  "end": 32.95,
  "text": "才发现这种能力"
 },
 {
  "start": 32.95,
  "end": 34.99,
  "text": "竟然是可以后天锻炼出来的"
 },
 {
  "start": 34.99,
  "end": 36.07,
  "text": "而学的杂"
 },
 {
  "start": 36.07,
  "end": 38.47,
  "text": "恰好就是其中的一个前置条件"
 },
 {
  "start": 38.47,
  "end": 39.39,
  "text": "哎别急"
 },
 {
  "start": 39.39,
  "end": 40.79,
  "text": "我先泼一盆冷水"
 },
 {
  "start": 40.79,
  "end": 41.75,
  "text": "你不会真的以为"
 },
 {
  "start": 41.75,
  "end": 43.63,
  "text": "啥都学点就能出列旁通了吧"
 },
 {
  "start": 43.63,
  "end": 45.15,
  "text": "那肯定没有这么简单"
 },
 {
  "start": 45.15,
  "end": 46.67,
  "text": "所以我们今天就来看看"
 },
 {
  "start": 46.67,
  "end": 48.55,
  "text": "想要真正拥有这种能力"
 },
 {
  "start": 48.55,
  "end": 51.23,
  "text": "你要先摸清的四个机制"
 },
 {
  "start": 51.23,
  "end": 52.71,
  "text": "他们分别是图式归纳"
 },
 {
  "start": 52.71,
  "end": 53.51,
  "text": "远迁移"
 },
 {
  "start": 53.51,
  "end": 56.03,
  "text": "认知灵活性和非典型组合"
 },
 {
  "start": 56.03,
  "end": 57.67,
  "text": "不管你现在有没有这种能力"
 },
 {
  "start": 57.67,
  "end": 58.79,
  "text": "探完这四个机制"
 },
 {
  "start": 58.79,
  "end": 61.71,
  "text": "都有可能让你的思维脱胎换骨"
 },
 {
  "start": 61.71,
  "end": 64.07,
  "text": "第一个机制叫做图式归纳"
 },
 {
  "start": 64.07,
  "end": 66.79,
  "text": "通俗一点说就是从经验里面提炼规律"
 },
 {
  "start": 66.79,
  "end": 68.31,
  "text": "1983年认知心理学家"
 },
 {
  "start": 68.31,
  "end": 69.27,
  "text": "做了这么一个实验"
 },
 {
  "start": 69.27,
  "end": 70.63,
  "text": "我觉得还挺有意思的"
 },
 {
  "start": 70.63,
  "end": 72.83,
  "text": "他们给被施者看了一个军事故事"
 },
 {
  "start": 72.83,
  "end": 74.75,
  "text": "说一个将军要攻打一座堡垒"
 },
 {
  "start": 74.75,
  "end": 76.55,
  "text": "但是沿途不满的地雷"
 },
 {
  "start": 76.55,
  "end": 78.83,
  "text": "大部队经过的话肯定会损失惨重"
 },
 {
  "start": 78.83,
  "end": 80.03,
  "text": "所以兵分几路"
 },
 {
  "start": 80.03,
  "end": 81.15,
  "text": "让小部队通过"
 },
 {
  "start": 81.15,
  "end": 83.03,
  "text": "再汇合到一起去强攻"
 },
 {
  "start": 83.03,
  "end": 84.91,
  "text": "我们现在听起来有点小儿科对吧"
 },
 {
  "start": 84.91,
  "end": 86.87,
  "text": "但真正的目的其实在后面"
 },
 {
  "start": 86.87,
  "end": 88.03,
  "text": "他们又让同一批人"
 },
 {
  "start": 88.03,
  "end": 89.55,
  "text": "去解决一道医学难题"
 },
 {
  "start": 89.55,
  "end": 92.63,
  "text": "说医生要用射线摧毁身体深处的肿瘤"
 },
 {
  "start": 92.63,
  "end": 95.15,
  "text": "只有射线强度足够高才能杀死肿瘤"
 },
 {
  "start": 95.15,
  "end": 97.67,
  "text": "但是同时会损伤沿途的健康阻止"
 },
 {
  "start": 97.67,
  "end": 98.79,
  "text": "那怎么办"
 },
 {
  "start": 98.79,
  "end": 101.35,
  "text": "诶 屏幕前聪明的你可能已经想到答案了"
 },
 {
  "start": 101.35,
  "end": 103.43,
  "text": "那我拆成多数低强度的射线"
 },
 {
  "start": 103.43,
  "end": 105.11,
  "text": "从不同的角度同时照射"
 },
 {
  "start": 105.11,
  "end": 107.43,
  "text": "在肿瘤处叠加不就行了吗"
 },
 {
  "start": 107.43,
  "end": 108.07,
  "text": "没错啊"
 },
 {
  "start": 108.07,
  "end": 110.23,
  "text": "但这个想法从哪来的"
 },
 {
  "start": 110.23,
  "end": 111.79,
  "text": "是不是从看似不相关的"
 },
 {
  "start": 111.79,
  "end": 113.63,
  "text": "军事故事中提炼出来的"
 },
 {
  "start": 113.63,
  "end": 115.63,
  "text": "其实实验的结果还拓宽了这一点"
 },
 {
  "start": 115.63,
  "end": 117.83,
  "text": "数据表示如果没有任何的提示"
 },
 {
  "start": 117.83,
  "end": 118.83,
  "text": "直接解题的话"
 },
 {
  "start": 118.87,
  "end": 120.91,
  "text": "只有10%的人能想到方案"
 },
 {
  "start": 120.91,
  "end": 122.39,
  "text": "而读了军事故事的人"
 },
 {
  "start": 122.39,
  "end": 123.79,
  "text": "却没有提醒的话"
 },
 {
  "start": 123.79,
  "end": 126.15,
  "text": "也只有30%的人能想到方案"
 },
 {
  "start": 126.15,
  "end": 128.99,
  "text": "那你想到方案说明你已经打败了这七成的人"
 },
 {
  "start": 128.99,
  "end": 130.19,
  "text": "但是读了故事"
 },
 {
  "start": 130.19,
  "end": 132.75,
  "text": "又加了一句用故事帮你解题"
 },
 {
  "start": 132.75,
  "end": 136.27,
  "text": "那成功率直接跳到了75%到92%"
 },
 {
  "start": 136.27,
  "end": 137.35,
  "text": "这说明了什么呢"
 },
 {
  "start": 137.35,
  "end": 139.39,
  "text": "说明即便答案就摆在你眼前"
 },
 {
  "start": 139.39,
  "end": 141.39,
  "text": "但大多数人依然是看不见的"
 },
 {
  "start": 141.39,
  "end": 143.71,
  "text": "因为他们看到的还是两个不同的故事"
 },
 {
  "start": 143.71,
  "end": 145.55,
  "text": "只有少数的人能看到"
 },
 {
  "start": 145.55,
  "end": 147.91,
  "text": "这俩故事其实是同一个结构"
 },
 {
  "start": 147.91,
  "end": 149.19,
  "text": "这就是图示归纳"
 },
 {
  "start": 149.19,
  "end": 150.99,
  "text": "不是说你记住了更多的知识"
 },
 {
  "start": 150.99,
  "end": 152.87,
  "text": "而是从案例里面提炼出了"
 },
 {
  "start": 152.87,
  "end": 154.71,
  "text": "可以复用的底层结构"
 },
 {
  "start": 154.71,
  "end": 156.99,
  "text": "所以我们应该怎么训练这种能力呢"
 },
 {
  "start": 156.99,
  "end": 158.15,
  "text": "其实也很简单"
 },
 {
  "start": 158.15,
  "end": 159.39,
  "text": "就是去做比较"
 },
 {
  "start": 159.39,
  "end": 160.79,
  "text": "而不是单独学习"
 },
 {
  "start": 160.79,
  "end": 162.03,
  "text": "单独看一个案例的话"
 },
 {
  "start": 162.03,
  "end": 163.55,
  "text": "你只能得到一个故事"
 },
 {
  "start": 163.55,
  "end": 165.99,
  "text": "但把两个案例放在一起比较"
 },
 {
  "start": 165.99,
  "end": 169.23,
  "text": "那你聪明的小脑袋就一定能提炼出规律"
 },
 {
  "start": 169.23,
  "end": 171.59,
  "text": "那第二个机制叫做远迁移"
 },
 {
  "start": 171.59,
  "end": 174.51,
  "text": "通俗说就是把规律用到意想不到的地方"
 },
 {
  "start": 174.51,
  "end": 177.03,
  "text": "图示归纳解决的是提炼结构的问题"
 },
 {
  "start": 177.03,
  "end": 180.91,
  "text": "而远迁移解决的是把结构用到哪里的问题"
 },
 {
  "start": 180.91,
  "end": 182.67,
  "text": "远迁移可能不太好理解"
 },
 {
  "start": 182.67,
  "end": 185.03,
  "text": "但是近迁移你一定用过"
 },
 {
  "start": 185.03,
  "end": 186.63,
  "text": "CNC加CNV是什么"
 },
 {
  "start": 186.63,
  "end": 187.95,
  "text": "是复制粘贴对吧"
 },
 {
  "start": 187.95,
  "end": 189.59,
  "text": "是不是不管换什么软件"
 },
 {
  "start": 189.59,
  "end": 191.23,
  "text": "你都会用这组快捷键"
 },
 {
  "start": 191.23,
  "end": 192.23,
  "text": "这就是近迁移"
 },
 {
  "start": 192.23,
  "end": 193.71,
  "text": "你习以为常的东西"
 },
 {
  "start": 193.71,
  "end": 196.51,
  "text": "但是远迁移才是真正拉开差距的能力"
 },
 {
  "start": 196.51,
  "end": 197.95,
  "text": "比如说运营一家奶茶店"
 },
 {
  "start": 197.95,
  "end": 199.47,
  "text": "和做一个短视频账号"
 },
 {
  "start": 199.47,
  "end": 200.51,
  "text": "一个卖小甜水"
 },
 {
  "start": 200.51,
  "end": 201.39,
  "text": "一个做内容"
 },
 {
  "start": 201.39,
  "end": 202.99,
  "text": "听起来好像八竿子打不着"
 },
 {
  "start": 202.99,
  "end": 204.71,
  "text": "但你只要换一个角度去看"
 },
 {
  "start": 204.71,
  "end": 206.55,
  "text": "就能发现它们的底层结构"
 },
 {
  "start": 206.55,
  "end": 207.59,
  "text": "其实很像"
 },
 {
  "start": 207.59,
  "end": 209.47,
  "text": "奶茶店要选人流量大的地段"
 },
 {
  "start": 209.47,
  "end": 211.83,
  "text": "短视频账号要选有流量的话题"
 },
 {
  "start": 211.83,
  "end": 214.39,
  "text": "所以话题就是账号的地段"
 },
 {
  "start": 214.39,
  "end": 215.91,
  "text": "奶茶店要有招牌产品"
 },
 {
  "start": 215.91,
  "end": 218.95,
  "text": "那做短视频账号也要有爆款的内容或者栏目"
 },
 {
  "start": 218.95,
  "end": 221.43,
  "text": "所以爆款就是账号的招牌奶茶"
 },
 {
  "start": 221.43,
  "end": 222.95,
  "text": "奶茶店要让顾客复购"
 },
 {
  "start": 222.95,
  "end": 225.47,
  "text": "短视频账号要让粉丝下肆嗨来看"
 },
 {
  "start": 225.47,
  "end": 227.35,
  "text": "所以关注 收藏 追根"
 },
 {
  "start": 227.35,
  "end": 229.87,
  "text": "本质上就是内容生意里边的复购"
 },
 {
  "start": 229.87,
  "end": 231.19,
  "text": "表面上一个是奶茶"
 },
 {
  "start": 231.19,
  "end": 232.19,
  "text": "一个是短视频"
 },
 {
  "start": 232.19,
  "end": 234.07,
  "text": "但底层都是流量入口"
 },
 {
  "start": 234.07,
  "end": 235.71,
  "text": "招牌产品 迟迟复购"
 },
 {
  "start": 235.71,
  "end": 237.19,
  "text": "这就是远迁移"
 },
 {
  "start": 237.19,
  "end": 238.27,
  "text": "会这种能力的人"
 },
 {
  "start": 238.27,
  "end": 240.39,
  "text": "学新东西的速度会非常的快"
 },
 {
  "start": 240.39,
  "end": 242.19,
  "text": "因为他们不是从零开始"
 },
 {
  "start": 242.19,
  "end": 243.99,
  "text": "而是找到了相似的结构"
 },
 {
  "start": 243.99,
  "end": 245.83,
  "text": "让新的领域不再陌生"
 },
 {
  "start": 245.83,
  "end": 247.23,
  "text": "其实就是一个旧结构"
 },
 {
  "start": 247.23,
  "end": 248.55,
  "text": "换了一套新皮肤"
 },
 {
  "start": 248.55,
  "end": 250.15,
  "text": "但千万要注意的一点是"
 },
 {
  "start": 250.15,
  "end": 251.99,
  "text": "不要强行的去做类比"
 },
 {
  "start": 251.99,
  "end": 254.43,
  "text": "因为不是所有的东西都能套在一起"
 },
 {
  "start": 254.43,
  "end": 256.51,
  "text": "比如说谈恋爱其实有点像做产品"
 },
 {
  "start": 256.51,
  "end": 259.43,
  "text": "都要重视体验 反馈 长期维护"
 },
 {
  "start": 259.43,
  "end": 262.03,
  "text": "但你真的要把对象当做用户去运营"
 },
 {
  "start": 262.03,
  "end": 263.63,
  "text": "天天又分析又复盘"
 },
 {
  "start": 263.63,
  "end": 265.39,
  "text": "那你就离拉黑不远了"
 },
 {
  "start": 265.39,
  "end": 267.35,
  "text": "所以高手不是看什么都一样"
 },
 {
  "start": 267.35,
  "end": 269.87,
  "text": "而是知道哪里像 哪里不像"
 },
 {
  "start": 269.87,
  "end": 271.87,
  "text": "想要训练远迁移的这种能力"
 },
 {
  "start": 271.87,
  "end": 273.15,
  "text": "也是这三个问题"
 },
 {
  "start": 273.15,
  "end": 276.19,
  "text": "它像什么 哪里像 哪里不像"
 },
 {
  "start": 276.19,
  "end": 277.83,
  "text": "前两个问题帮你迁移"
 },
 {
  "start": 277.83,
  "end": 280.35,
  "text": "第三个问题防止你瞎迁移"
 },
 {
  "start": 280.35,
  "end": 281.83,
  "text": "所以真正的出类旁通"
 },
 {
  "start": 281.83,
  "end": 283.39,
  "text": "它不是看什么都一样"
 },
 {
  "start": 283.39,
  "end": 285.83,
  "text": "而是你能在不同里面看见相同"
 },
 {
  "start": 285.83,
  "end": 288.67,
  "text": "也能在相同里面看到不同的边界"
 },
 {
  "start": 288.67,
  "end": 290.07,
  "text": "那第三个机制是什么呢"
 },
 {
  "start": 290.07,
  "end": 291.67,
  "text": "叫做认知灵活性"
 },
 {
  "start": 291.67,
  "end": 293.79,
  "text": "也就是说不要被单一的视角琐死"
 },
 {
  "start": 293.79,
  "end": 296.51,
  "text": "这也是很多纯专才容易犯的一个错误"
 },
 {
  "start": 296.51,
  "end": 297.87,
  "text": "像什么都学的这种"
 },
 {
  "start": 297.87,
  "end": 299.47,
  "text": "我们一般称之为通才"
 },
 {
  "start": 299.47,
  "end": 301.79,
  "text": "那专才呢 就是一条道走到黑"
 },
 {
  "start": 301.79,
  "end": 302.87,
  "text": "我就学一件事"
 },
 {
  "start": 302.87,
  "end": 304.55,
  "text": "我就把它学通学透"
 },
 {
  "start": 304.55,
  "end": 306.19,
  "text": "所以纯专才就很容易"
 },
 {
  "start": 306.19,
  "end": 308.11,
  "text": "用自己熟悉的领域框架"
 },
 {
  "start": 308.11,
  "end": 310.47,
  "text": "去否定陌生领域的机会"
 },
 {
  "start": 310.47,
  "end": 311.95,
  "text": "我们还拿短视频来举例"
 },
 {
  "start": 311.95,
  "end": 313.35,
  "text": "这个行业刚起步的时候"
 },
 {
  "start": 313.35,
  "end": 314.91,
  "text": "很多传统媒体人说"
 },
 {
  "start": 314.91,
  "end": 317.55,
  "text": "这个东西太碎太浅不专业"
 },
 {
  "start": 317.55,
  "end": 318.79,
  "text": "那电商也是一样"
 },
 {
  "start": 318.79,
  "end": 320.67,
  "text": "像夏琳受伤觉得没有体验"
 },
 {
  "start": 320.67,
  "end": 322.67,
  "text": "没有信任度肯定不会长久"
 },
 {
  "start": 322.67,
  "end": 324.27,
  "text": "你说他们是不够聪明吗"
 },
 {
  "start": 324.27,
  "end": 325.19,
  "text": "那肯定不是"
 },
 {
  "start": 325.19,
  "end": 326.71,
  "text": "人家一年也赚不少钱"
 },
 {
  "start": 326.71,
  "end": 329.27,
  "text": "但他们就是很难去抓住这些风口"
 },
 {
  "start": 329.27,
  "end": 330.23,
  "text": "因为他们的思维"
 },
 {
  "start": 330.23,
  "end": 332.31,
  "text": "已经被自己的框架锁死了"
 },
 {
  "start": 332.31,
  "end": 333.35,
  "text": "所以认知灵活性"
 },
 {
  "start": 333.35,
  "end": 335.79,
  "text": "其实就是打破墨守成规的思维方式"
 },
 {
  "start": 335.79,
  "end": 338.63,
  "text": "能在不同的框架之间进行自由切换"
 },
 {
  "start": 338.63,
  "end": 340.07,
  "text": "专业判断你肯定要有"
 },
 {
  "start": 340.07,
  "end": 341.59,
  "text": "但是你得在用旧框架"
 },
 {
  "start": 341.59,
  "end": 343.03,
  "text": "否定一件事之前"
 },
 {
  "start": 343.03,
  "end": 344.87,
  "text": "先在脑袋里去检索一遍"
 },
 {
  "start": 344.87,
  "end": 346.31,
  "text": "有没有类似的框架"
 },
 {
  "start": 346.31,
  "end": 347.79,
  "text": "有没有新的视角"
 },
 {
  "start": 347.79,
  "end": 349.15,
  "text": "只要你养成这个习惯"
 },
 {
  "start": 349.15,
  "end": 352.03,
  "text": "就能打开很多人都看不见的那扇门"
 },
 {
  "start": 352.03,
  "end": 354.51,
  "text": "第四个机制叫做非典型组合"
 },
 {
  "start": 354.51,
  "end": 356.59,
  "text": "这也是机会真正的来源"
 },
 {
  "start": 356.59,
  "end": 358.11,
  "text": "什么叫做非典型组合"
 },
 {
  "start": 358.11,
  "end": 359.99,
  "text": "其实就是把不同领域的知识"
 },
 {
  "start": 359.99,
  "end": 360.99,
  "text": "桥接在一起"
 },
 {
  "start": 360.99,
  "end": 362.51,
  "text": "组成一个看似熟悉"
 },
 {
  "start": 362.51,
  "end": 364.55,
  "text": "但又出乎意料的结合方式"
 },
 {
  "start": 364.55,
  "end": 367.55,
  "text": "这个机制更像是前三个机制的结合产物"
 },
 {
  "start": 367.55,
  "end": 368.99,
  "text": "在此上有一篇研究"
 },
 {
  "start": 368.99,
  "end": 371.67,
  "text": "在分析了大量的科学论文之后发现"
 },
 {
  "start": 371.67,
  "end": 373.23,
  "text": "最具影响力的创新"
 },
 {
  "start": 373.23,
  "end": 375.19,
  "text": "它一般都不是凭空出现的"
 },
 {
  "start": 375.19,
  "end": 377.11,
  "text": "只是在大量的常规知识里"
 },
 {
  "start": 377.11,
  "end": 379.59,
  "text": "加入了少量的非典型组合"
 },
 {
  "start": 379.59,
  "end": 381.59,
  "text": "所以我们经常听到的一句话是什么"
 },
 {
  "start": 381.59,
  "end": 384.19,
  "text": "说现在几乎没有真正的创新了"
 },
 {
  "start": 384.19,
  "end": 386.11,
  "text": "就像手工梗发明的那些东西"
 },
 {
  "start": 386.11,
  "end": 387.39,
  "text": "好像都没什么用"
 },
 {
  "start": 387.39,
  "end": 389.31,
  "text": "但一旦结合了互联网的传播"
 },
 {
  "start": 389.31,
  "end": 391.55,
  "text": "就变成了一种非常稀缺的价值"
 },
 {
  "start": 391.55,
  "end": 393.95,
  "text": "所以说白了就是真正赚钱的机会"
 },
 {
  "start": 393.95,
  "end": 396.43,
  "text": "不是说你必须得发明一个全新的东西"
 },
 {
  "start": 396.43,
  "end": 398.95,
  "text": "而是把你自己已经有的成熟的经验"
 },
 {
  "start": 398.95,
  "end": 401.55,
  "text": "迁移到一个还没有被开发过的领域"
 },
 {
  "start": 401.55,
  "end": 402.87,
  "text": "把游戏里面的积分"
 },
 {
  "start": 402.87,
  "end": 403.51,
  "text": "等级"
 },
 {
  "start": 403.51,
  "end": 404.31,
  "text": "及时反馈"
 },
 {
  "start": 404.31,
  "end": 405.63,
  "text": "迁移到教育力是什么"
 },
 {
  "start": 405.63,
  "end": 407.15,
  "text": "那就是游戏化学习"
 },
 {
  "start": 407.15,
  "end": 408.55,
  "text": "把短视频的传播逻辑"
 },
 {
  "start": 408.55,
  "end": 410.03,
  "text": "所以你说这些机会"
 },
 {
  "start": 410.03,
  "end": 411.83,
  "text": "它是多天才的人想出来的吗"
 },
 {
  "start": 411.83,
  "end": 414.19,
  "text": "其实他们就是提前看到了这种结构"
 },
 {
  "start": 414.19,
  "end": 416.07,
  "text": "然后进行了排列组合而已"
 },
 {
  "start": 416.07,
  "end": 418.43,
  "text": "OK 那我接下来再破一盘连结"
 },
 {
  "start": 418.43,
  "end": 420.07,
  "text": "很多人觉得我兴趣广泛"
 },
 {
  "start": 420.07,
  "end": 421.07,
  "text": "我什么都学点"
 },
 {
  "start": 421.07,
  "end": 422.15,
  "text": "我就是通才"
 },
 {
  "start": 422.15,
  "end": 423.35,
  "text": "那肯定不是啊"
 },
 {
  "start": 423.35,
  "end": 424.75,
  "text": "那个叫浅长哲智"
 },
 {
  "start": 424.75,
  "end": 426.75,
  "text": "如果你抱着这个误解去努力的话"
 },
 {
  "start": 426.75,
  "end": 428.35,
  "text": "那你就会越来越骄人"
 },
 {
  "start": 428.35,
  "end": 430.15,
  "text": "说实话我也走过这段弯路"
 },
 {
  "start": 430.15,
  "end": 432.75,
  "text": "像音乐 科技 心理 杂七杂八"
 },
 {
  "start": 432.75,
  "end": 433.55,
  "text": "什么都学"
 },
 {
  "start": 433.55,
  "end": 435.15,
  "text": "直到我大四的时候才发现"
 },
 {
  "start": 435.15,
  "end": 436.87,
  "text": "我缺少了一个优点"
 },
 {
  "start": 436.87,
  "end": 438.07,
  "text": "大四的时候才发现"
 },
 {
  "start": 438.07,
  "end": 439.87,
  "text": "我缺少一个纵向能力"
 },
 {
  "start": 439.87,
  "end": 441.87,
  "text": "那我很难在这个社会立足"
 },
 {
  "start": 441.87,
  "end": 443.87,
  "text": "所以我先报班学了全站工程师"
 },
 {
  "start": 443.87,
  "end": 446.07,
  "text": "后来又转行学了全站设计师"
 },
 {
  "start": 446.07,
  "end": 447.67,
  "text": "也就是在这个过程里面我发现"
 },
 {
  "start": 447.67,
  "end": 450.47,
  "text": "以前学的很多看似不相关的东西"
 },
 {
  "start": 450.47,
  "end": 452.67,
  "text": "都对这条纵向路径有加持"
 },
 {
  "start": 452.67,
  "end": 454.67,
  "text": "所以学起来非常的快"
 },
 {
  "start": 454.67,
  "end": 456.87,
  "text": "所以要是一直以广度优先为标准"
 },
 {
  "start": 456.87,
  "end": 458.67,
  "text": "去拓宽自己的知识横轴"
 },
 {
  "start": 458.67,
  "end": 460.67,
  "text": "那你会一直飘着落不了地"
 },
 {
  "start": 460.67,
  "end": 461.67,
  "text": "那个不叫通才"
 },
 {
  "start": 461.67,
  "end": 463.87,
  "text": "那个叫冷知识收集癖"
 },
 {
  "start": 463.87,
  "end": 465.87,
  "text": "那真正有价值的认知结构是什么"
 },
 {
  "start": 465.87,
  "end": 467.67,
  "text": "是你先得有一口井"
 },
 {
  "start": 467.67,
  "end": 470.47,
  "text": "再围着井口去扩充一整片地图"
 },
 {
  "start": 470.47,
  "end": 471.67,
  "text": "这就有点像什么呢"
 },
 {
  "start": 471.67,
  "end": 473.87,
  "text": "就像我们在开放世界里探索的时候"
 },
 {
  "start": 473.87,
  "end": 475.07,
  "text": "需要先找到灯塔"
 },
 {
  "start": 475.07,
  "end": 476.27,
  "text": "先去开一个锚点"
 },
 {
  "start": 476.27,
  "end": 477.67,
  "text": "然后再探索地图"
 },
 {
  "start": 477.67,
  "end": 479.87,
  "text": "那这口井它就是你的专业能力"
 },
 {
  "start": 479.87,
  "end": 481.87,
  "text": "它能保证你不被咳死"
 },
 {
  "start": 481.87,
  "end": 484.27,
  "text": "那地图就是你的跨界视野"
 },
 {
  "start": 484.27,
  "end": 486.87,
  "text": "能让你进一步去探索自己的能力边界"
 },
 {
  "start": 486.87,
  "end": 489.47,
  "text": "这样你才能既不飘又不窄"
 },
 {
  "start": 489.47,
  "end": 491.67,
  "text": "这就是现在企业最喜欢的"
 },
 {
  "start": 491.67,
  "end": 493.87,
  "text": "所谓的T型人才"
 },
 {
  "start": 493.87,
  "end": 494.87,
  "text": "所以从今天开始"
 },
 {
  "start": 494.87,
  "end": 496.27,
  "text": "你可以培养一个习惯"
 },
 {
  "start": 496.27,
  "end": 497.47,
  "text": "每学到一个新东西"
 },
 {
  "start": 497.47,
  "end": 498.47,
  "text": "就问问自己"
 },
 {
  "start": 498.47,
  "end": 500.87,
  "text": "它像我以前见到过的什么东西"
 },
 {
  "start": 500.87,
  "end": 502.47,
  "text": "甚至你可以准备一个本子"
 },
 {
  "start": 502.47,
  "end": 504.47,
  "text": "把新知识和旧经验全都写上去"
 },
 {
  "start": 504.47,
  "end": 506.07,
  "text": "然后去强行连线"
 },
 {
  "start": 506.07,
  "end": 507.67,
  "text": "这个东西最后就会变成你"
 },
 {
  "start": 507.67,
  "end": 509.07,
  "text": "专属的思维体系"
 },
 {
  "start": 509.07,
  "end": 510.07,
  "text": "而这个方式"
 },
 {
  "start": 510.07,
  "end": 512.67,
  "text": "就是激活以上四个机制的开关"
 },
 {
  "start": 512.67,
  "end": 513.87,
  "text": "慢慢的你就会发现"
 },
 {
  "start": 513.87,
  "end": 515.47,
  "text": "你不只是学了点东西"
 },
 {
  "start": 515.47,
  "end": 516.87,
  "text": "而是真正拥有了"
 },
 {
  "start": 516.87,
  "end": 518.67,
  "text": "这种触类旁通的能力"
 },
 {
  "start": 518.67,
  "end": 520.07,
  "text": "那最后我还想补充一句"
 },
 {
  "start": 520.07,
  "end": 521.47,
  "text": "其实AI时代的来临"
 },
 {
  "start": 521.47,
  "end": 522.87,
  "text": "已经帮我们补足了"
 },
 {
  "start": 522.87,
  "end": 524.07,
  "text": "专业深度的问题"
 },
 {
  "start": 524.07,
  "end": 525.07,
  "text": "所以你的本事"
 },
 {
  "start": 525.07,
  "end": 527.47,
  "text": "从这个时代才真正开始发挥"
 },
 {
  "start": 527.47,
  "end": 528.87,
  "text": "祝大家能知道很多道理"
 },
 {
  "start": 528.87,
  "end": 529.67,
  "text": "也能过好这一生"
 },
 {
  "start": 529.67,
  "end": 530.87,
  "text": "我们下期再见"
 }
]